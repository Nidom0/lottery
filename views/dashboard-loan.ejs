<%- include('partials/navbar') %>

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>داشبورد وام</title>
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    body {
      margin: 0;
      background: linear-gradient(135deg,#0d0f1b,#101326,#141a33,#0d1125);
      font-family: Vazirmatn, sans-serif;
      color: white;
    }

    .container {
      max-width: 1350px;
      margin: 120px auto;
      padding: 25px;
    }

    .glass {
      background: rgba(255,255,255,0.06);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 18px;
      padding: 25px;
      box-shadow: 0 12px 28px rgba(0,0,0,0.45);
      margin-bottom: 28px;
    }

    .page-title {
      font-size: 26px;
      font-weight: 700;
      color: #7ec7ff;
      margin: 0 0 6px;
    }

    .page-sub { opacity: .6; font-size: 14px; }

    .stats {
      display: flex;
      gap: 22px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }

    .stat {
      flex: 1;
      min-width: 180px;
      background: rgba(255,255,255,0.08);
      padding: 22px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 10px 22px rgba(0,0,0,0.35);
    }

    .stat-icon { font-size: 42px; color: #6aa7ff; }
    .stat-label { opacity: .75; font-size: 14px; margin-bottom: 6px; }
    .stat-number { font-size: 30px; font-weight: 700; }

    .loan-types {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin-bottom: 28px;
    }

    .loan-card {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 16px;
      padding: 22px;
      transition: .25s;
      text-decoration: none;
      color: #fff;
      display: block;
    }

    .loan-card:hover {
      background: rgba(255,255,255,0.1);
      transform: translateY(-4px);
      box-shadow: 0 15px 32px rgba(0,0,0,0.4);
    }

    .loan-card-icon {
      font-size: 36px;
      margin-bottom: 12px;
      display: block;
      color: #6aa7ff;
    }

    .loan-card h3 { margin: 0 0 8px; font-size: 18px; color: #8fd3ff; }
    .loan-card p { margin: 0; opacity: .65; font-size: 14px; line-height: 1.7; }

    .info-banner {
      display: flex;
      align-items: center;
      gap: 16px;
      background: rgba(255,207,85,0.08);
      border: 1px solid rgba(255,207,85,0.2);
      border-radius: 14px;
      padding: 18px 22px;
      color: #ffd76f;
      font-size: 14px;
      line-height: 1.7;
    }

    .info-banner i { font-size: 28px; flex-shrink: 0; }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      padding: 14px;
      background: rgba(0,0,0,0.35);
      font-weight: 700;
      font-size: 14px;
    }

    td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      text-align: center;
      font-size: 14px;
    }

    tr:hover td { background: rgba(255,255,255,0.04); }

    .btn-main {
      padding: 7px 16px;
      background: linear-gradient(135deg,#3a8bff,#6aa7ff);
      border-radius: 10px;
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
      display: inline-block;
    }
  </style>
</head>
<body>

<div class="container">

  <div class="glass">
    <div class="page-title"><i class="bi bi-cash-coin" style="margin-left:10px;"></i>داشبورد وام</div>
    <div class="page-sub">مدیریت وام‌ها، اقساط و مشتریان</div>
  </div>

  <div class="stats">
    <div class="stat">
      <div>
        <div class="stat-label">کل مشتریان ثبت‌شده</div>
        <div class="stat-number"><%= totalCustomers %></div>
      </div>
      <i class="bi bi-people stat-icon"></i>
    </div>

    <div class="stat">
      <div>
        <div class="stat-label">اطلاعات تکمیل‌شده</div>
        <div class="stat-number"><%= totalInfoComplete %></div>
      </div>
      <i class="bi bi-check-circle stat-icon"></i>
    </div>

    <div class="stat">
      <div>
        <div class="stat-label">مشاهده کرده‌اند</div>
        <div class="stat-number"><%= totalViewed %></div>
      </div>
      <i class="bi bi-eye stat-icon"></i>
    </div>
  </div>

  <div class="loan-types">
    <a href="/loans/gold" class="loan-card">
      <i class="bi bi-gem loan-card-icon"></i>
      <h3>وام طلا</h3>
      <p>تسهیلات خرید طلا و جواهر با ضمانت و اقساط مناسب</p>
    </a>

    <a href="/loans/housing" class="loan-card">
      <i class="bi bi-house-door loan-card-icon"></i>
      <h3>وام مسکن</h3>
      <p>تسهیلات خرید و ساخت مسکن با پشتوانه طلا</p>
    </a>

    <a href="/loans/car" class="loan-card">
      <i class="bi bi-car-front loan-card-icon"></i>
      <h3>وام خودرو</h3>
      <p>خرید خودرو نو و کارکرده با حداقل پیش‌پرداخت</p>
    </a>
  </div>

  <div class="glass info-banner" style="margin-bottom:28px;">
    <i class="bi bi-info-circle"></i>
    <span>
      این بخش در حال توسعه است. مشتریانی که اطلاعات هویتی و بانکی خود را تکمیل کرده‌اند از طریق داشبورد قرعه‌کشی قابل مشاهده هستند.
      برای مدیریت برندگان به <a href="/dashboard/lottery" style="color:#ffd76f; font-weight:700;">داشبورد قرعه‌کشی</a> مراجعه کنید.
    </span>
  </div>

  <div class="glass">
    <h3 style="margin: 0 0 16px; color: #8ab8ff;">آخرین مشتریان با اطلاعات کامل</h3>
    <table>
      <thead>
        <tr>
          <th>نام</th>
          <th>موبایل</th>
          <th>کد ملی</th>
          <th>شماره کارت</th>
          <th>تاریخ ثبت</th>
          <th>پروفایل</th>
        </tr>
      </thead>
      <tbody>
        <% winners.filter(w => w.infoComplete).forEach(w => { %>
          <tr>
            <td><%= w.fullName %></td>
            <td><%= w.phone %></td>
            <td><%= w.nationalId || '—' %></td>
            <td><%= w.cardNumber || '—' %></td>
            <td><%= w.createdAt ? w.createdAt.toLocaleString("fa-IR") : "—" %></td>
            <td><a href="/dashboard/lottery/profile/<%= w.id %>" class="btn-main">مشاهده</a></td>
          </tr>
        <% }) %>
        <% if (!winners.some(w => w.infoComplete)) { %>
          <tr><td colspan="6" style="opacity:.5; padding:20px;">هنوز مشتری با اطلاعات کامل ثبت نشده است</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

</div>

</body>
</html>
