<%- include('partials/navbar') %>

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<title>ویرایش برنده</title>

<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  body {
    margin: 0;
    background: linear-gradient(135deg,#0d0f1b,#13172b,#141a33);
    font-family: Vazirmatn, sans-serif;
    color: #fff;
    padding-top: 110px;
    padding-bottom: 60px;
  }

  .page-wrapper {
    max-width: 760px;
    margin: auto;
    padding: 20px;
  }

  .glass {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(16px);
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 15px 38px rgba(0,0,0,0.4);
  }

  h2 { margin: 0 0 22px; color: #7ec7ff; }

  label {
    display: block;
    margin-top: 14px;
    margin-bottom: 6px;
    font-size: 14px;
    opacity: .85;
    font-weight: 600;
  }

  input, select {
    width: 100%;
    padding: 12px 14px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 12px;
    color: #fff;
    outline: none;
    font-size: 14px;
    font-family: Vazirmatn, sans-serif;
    box-sizing: border-box;
  }

  input:focus, select:focus { border-color: #6ab8ff; }

  select option { background: #101326; color: #fff; }

  .btn-main {
    background: linear-gradient(135deg,#3a8bff,#6aa7ff);
    padding: 12px 26px;
    border-radius: 50px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    color: #fff;
    margin-top: 20px;
    box-shadow: 0 6px 20px rgba(60,120,255,0.4);
    transition: .25s;
    font-size: 15px;
    font-family: Vazirmatn, sans-serif;
  }

  .btn-main:hover { transform: translateY(-3px); }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #8ab8ff;
    text-decoration: none;
    margin-bottom: 20px;
    font-size: 14px;
    opacity: .8;
    transition: .2s;
  }

  .btn-back:hover { opacity: 1; }

  .alert { padding: 12px 16px; border-radius: 12px; margin-bottom: 14px; }
  .alert.success { background: rgba(120,255,180,0.15); border: 1px solid rgba(120,255,180,0.4); color: #7ef3c0; }
</style>
</head>
<body>

<div class="page-wrapper">
  <a href="/dashboard/lottery/profile/<%= winner.id %>" class="btn-back">
    <i class="bi bi-arrow-right"></i> بازگشت به پروفایل
  </a>

  <div class="glass">
    <h2><i class="bi bi-pencil-square" style="margin-left:8px;"></i>ویرایش برنده</h2>

    <% if (message) { %>
      <div class="alert success"><%= message %></div>
    <% } %>

    <form method="POST" action="/dashboard/lottery/edit/<%= winner.id %>">

      <label>نام و نام خانوادگی</label>
      <input type="text" name="fullName" value="<%= winner.fullName || '' %>" required>

      <label>شماره تماس</label>
      <input type="text" name="phone" value="<%= winner.phone || '' %>" required>

      <label>مبلغ یا نوع جایزه</label>
      <input type="text" name="prize" value="<%= winner.prize || '' %>">

      <label>تاریخ اعلام برنده</label>
      <input type="date" name="winDate" value="<%= winner.winDate || '' %>">

      <label>تمپلیت</label>
      <select name="templateId" required>
        <option value="">انتخاب کنید…</option>
        <% templates.forEach(t => { %>
          <option value="<%= t.id %>" <%= winner.templateId == t.id ? 'selected' : '' %>><%= t.title %></option>
        <% }) %>
      </select>

      <button class="btn-main" type="submit">
        <i class="bi bi-check-lg" style="margin-left:6px;"></i>ذخیره تغییرات
      </button>

    </form>
  </div>
</div>

</body>
</html>
